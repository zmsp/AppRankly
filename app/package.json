{
  "name": "apprankly",
  "version": "1.0.0",
  "description": "Google Play Store app statistics viewer with interactive dashboard and CLI utility",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "cli": "node cli.js",
    "db:migrate": "node -e \"require('./lib/db/index.js').migrate()\"",
    "db:backfill": "node cli.js backfill",
    "db:status": "node cli.js status",
    "cache:clear": "node cli.js cache-clear",
    "build": "npm run build:frontend",
    "build:static": "npm run build:frontend && node generate_static_data.js",
    "build:demo": "npm run build:frontend && node generate_static_data.js --demo --no-pass",
    "build:frontend": "cd frontend && npm install && npm run build",
    "dev:frontend": "cd frontend && npm run dev",
    "watch:frontend": "cd frontend && npm run build -- --watch",
    "dev": "concurrently \"npm run server\" \"npm run dev:frontend\" \"npm run watch:frontend\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@fast-csv/parse": "^4.3.6",
    "@google-cloud/storage": "^5.19.4",
    "@google/genai": "^2.13.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "google-play-scraper": "^10.1.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "openai": "^6.48.0",
    "yargs": "^13.2.2"
  },
  "keywords": [
    "playstore",
    "statistics",
    "dashboard",
    "cli"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
